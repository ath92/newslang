{
  "name": "newslang",
  "version": "0.1.0",
  "description": "A language-learning mobile web app",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "predeploy": "pnpm clean",
    "prebuild:staging": "pnpm clean",
    "deploy": "vite build && wrangler deploy",
    "build:staging": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build --mode staging",
    "deploy:staging": "pnpm build:staging && node scripts/patch-staging-config.mjs && wrangler deploy --config dist/newslang/wrangler.json",
    "deploy:staging:gh": "node scripts/staging-deploy.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260710.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.7",
    "wrangler": "^4.130.0"
  }
}

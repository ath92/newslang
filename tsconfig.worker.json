{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` (pnpm cf-typegen)
  // and supplies both the `Env` binding interface and the Workers runtime types.
  "include": ["worker", "worker-configuration.d.ts"]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newslang",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-03-01",
  // Workers AI: quiz generation and open-answer grading.
  "ai": {
    "binding": "AI",
  },
  // One SQLite-backed Durable Object per user. Each instance keeps its own
  // embedded SQLite database of saved translations and their contexts.
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSLATION_STORE",
        "class_name": "TranslationStore",
      },
    ],
  },
  "exports": {
    "TranslationStore": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  // Serve from the default *.workers.dev subdomain (no custom domain configured yet).
  "workers_dev": true,
  "vars": {
    "APP_ENV": "production",
    // Workers AI models for the article quiz (see worker/quiz.ts).
    "QUIZ_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "QUIZ_GRADE_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    // Contact URI sent to push services with VAPID. The public/private key pair
    // itself is set per environment with `wrangler secret put` (see README).
    "VAPID_SUBJECT": "mailto:hello@newslang.app",
  },
  // The static Vite build. `directory` is intentionally omitted: the
  // @cloudflare/vite-plugin auto-populates it from the client build output.
  // `single-page-application` serves index.html for any unmatched navigation,
  // which is what a client-routed React SPA needs. `run_worker_first` lists the
  // paths that boot the Worker; everything else is served from the assets layer.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "env": {
    "staging": {
      "name": "newslang-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
      },
    },
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
